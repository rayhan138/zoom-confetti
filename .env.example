# Zoom Confetti App environment template
# Copy this file to `.env` and fill in your local development values.
# Never commit `.env`.

# Zoom Developer credentials from the Zoom App Marketplace.
ZM_CLIENT_ID=your_zoom_client_id_here
ZM_CLIENT_SECRET=your_zoom_client_secret_here

# Must exactly match the OAuth Redirect URL in Zoom Marketplace.
# Example: https://your-tunnel.trycloudflare.com/api/zoom/auth
ZM_REDIRECT_URL=https://your-public-domain.example/api/zoom/auth

# Used to sign the Zoom OAuth session cookie.
SESSION_SECRET=replace_with_a_long_random_secret

# Local server port.
PORT=3000
