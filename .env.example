# Zoom Confetti App Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials

# Zoom Developer Credentials (from Zoom Marketplace)
ZM_CLIENT_ID=your_zoom_client_id_here
ZM_CLIENT_SECRET=your_zoom_client_secret_here

# Redirect URL must match the configuration in your Zoom Developer Portal
# Typically: https://<ngrok-subdomain>.ngrok-free.app/api/zoom/auth
ZM_REDIRECT_URL=https://your-tunnel-subdomain.ngrok-free.app/api/zoom/auth

# Cookie security and server configurations
SESSION_SECRET=a_long_random_secret_string_for_signing_cookies
PORT=3000
